{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('active').val() === true && newData.child('selfSignup').val() === true && !newData.child('subjects').exists() && !newData.child('purchased').exists()))",
        ".validate": "newData.hasChildren(['name', 'email', 'active'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "subjects": {
          "$subject": {
            ".validate": "newData.isBoolean()"
          }
        },
        "purchased": {
          "$subject": {
            ".validate": "newData.isNumber()"
          }
        },
        "selfSignup": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "qbank": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('subjects').child($subject).val() === true || root.child('users').child(auth.uid).child('purchased').child($subject).val() > now)))",
      "$subject": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('subjects').child($subject).val() === true || (root.child('users').child(auth.uid).child('purchased').child($subject).exists() && root.child('users').child(auth.uid).child('purchased').child($subject).val() > now))))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('subjects').child($subject).val() === true))",
        "$id": {
          ".validate": "!newData.exists() || newData.hasChild('id')"
        }
      }
    },
    "bprows": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('subjects').child($subject).val() === true || root.child('users').child(auth.uid).child('purchased').child($subject).val() > now)))",
      "$subject": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('subjects').child($subject).val() === true || (root.child('users').child(auth.uid).child('purchased').child($subject).exists() && root.child('users').child(auth.uid).child('purchased').child($subject).val() > now))))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('subjects').child($subject).val() === true))",
        "$id": {
          ".validate": "!newData.exists() || newData.hasChild('id')"
        }
      }
    },
    "database": {
      "savedBlueprints": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "settings": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "licenses": {
      "$emailKey": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChild('email')",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "notice": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "subjects": {
          "$s": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userdata": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('active').val() === true)",
        "exams": {
          "$exam": {
            ".validate": "$exam === 'UNIT_TEST' || $exam === 'FIRST_TERMINAL' || $exam === 'SECOND_TERMINAL' || $exam === 'ANNUAL' || $exam === 'UNSORTED'",
            "blueprints": {
              "$id": {
                ".validate": "newData.hasChild('id')"
              }
            },
            "papers": {
              "$id": {
                ".validate": "newData.hasChild('id')"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "licenseLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "payRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['id','email','kind','amount','utr','createdAt','status']) && (newData.child('kind').val() === 'plan' || newData.hasChild('subject'))",
        "id": {
          ".validate": "newData.val() === $id"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+\\.[^@ ]+$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "kind": {
          ".validate": "newData.val() === 'plan' || newData.val() === 'subject'"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "subjectName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000"
        },
        "utr": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{10,30}$/)"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'approving' || newData.val() === 'approved' || newData.val() === 'rejected'))"
        },
        "approvedAt": {
          ".validate": "newData.isNumber()"
        },
        "rejectReason": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "utrIndex": {
      "$utr": {
        ".write": "(!data.exists() && newData.exists() && $utr.matches(/^[A-Za-z0-9]{10,30}$/)) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },
    "catalog": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "guestdemo": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}